<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EcoFlowMonitor.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://EcoFlowMonitor.App/Themes/DesignSystem.axaml" />
        <StyleInclude Source="avares://EcoFlowMonitor.App/Themes/Typography.axaml" />
        <StyleInclude Source="avares://EcoFlowMonitor.App/Themes/Controls.axaml" />
    </Application.Styles>
</Application>
