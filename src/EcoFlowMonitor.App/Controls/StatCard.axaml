<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EcoFlowMonitor.Controls.StatCard"
             Margin="4">
    <Border Background="{StaticResource SurfaceCard}"
            BorderBrush="{StaticResource SurfaceCardBorder}"
            BorderThickness="1" CornerRadius="8" Padding="12,10">
        <StackPanel Spacing="4">
            <TextBlock x:Name="LabelText" Classes="CaptionUpper" />
            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="ValueText" Classes="MonoMedium" />
                <TextBlock x:Name="UnitText" Classes="BodySmall" VerticalAlignment="Bottom" Margin="2,0,0,1" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
