<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="!$(TargetFramework.Contains('macos'))">WinExe</OutputType>
    <!--
      OS-specific TFMs so each host only resolves projects it can actually build:
        - Linux host:   net10.0 (references Platform.Linux, also net10.0)
        - macOS host:   net10.0 + net10.0-macos (references Platform.macOS; the
                        -macos TFM produces a proper .app bundle)
        - Windows host: net10.0-windows10.0.19041.0 (Platform.Windows's TFM —
                        required to consume WinRT from the referenced project)

      Mixing TFMs across host boundaries at the CLI via `-p:TargetFrameworks=…`
      leaks to child projects through MSBuild and breaks Core/Platform.*, so
      we gate per-host here instead.
    -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX'))">net10.0;net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EcoFlowMonitor</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>
  <!-- macOS-specific properties -->
  <PropertyGroup Condition="$(TargetFramework.Contains('macos'))">
    <ApplicationId>com.ecoflowmonitor.app</ApplicationId>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <!-- Exclude CoreBluetooth adapter from non-macOS builds -->
  <ItemGroup Condition="!$(TargetFramework.Contains('macos'))">
    <Compile Remove="Services/CoreBluetoothBleAdapter.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.Avalonia" Version="2.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\EcoFlowMonitor.Core\EcoFlowMonitor.Core.csproj" />
    <ProjectReference Include="..\EcoFlowMonitor.Platform.Windows\EcoFlowMonitor.Platform.Windows.csproj" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <ProjectReference Include="..\EcoFlowMonitor.Platform.macOS\EcoFlowMonitor.Platform.macOS.csproj" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <ProjectReference Include="..\EcoFlowMonitor.Platform.Linux\EcoFlowMonitor.Platform.Linux.csproj" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>
</Project>
