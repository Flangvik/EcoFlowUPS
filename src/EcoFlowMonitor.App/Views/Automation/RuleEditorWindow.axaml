<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EcoFlowMonitor.ViewModels.Automation"
        xmlns:models="using:EcoFlowMonitor.Models"
        x:Class="EcoFlowMonitor.Views.Automation.RuleEditorWindow"
        x:DataType="vm:RuleEditorViewModel"
        Title="Edit Rule"
        Width="760" Height="820"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="{StaticResource BackgroundPrimary}">

  <ScrollViewer Padding="20">
    <StackPanel Spacing="14">

      <!-- Name + Enabled -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Rule name" Classes="CaptionUpper" />
          <TextBox Text="{Binding RuleName}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
          <TextBlock Text="Enabled" Classes="CaptionUpper" />
          <ToggleSwitch IsChecked="{Binding Enabled}" />
        </StackPanel>
      </Grid>

      <!-- Device -->
      <StackPanel Spacing="4">
        <TextBlock Text="Device" Classes="CaptionUpper" />
        <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:DeviceConfig">
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>

      <!-- Conditions (composite) -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="CONDITIONS" Classes="CaptionUpper" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="Ghost"
                    Content="Flip AND/OR"
                    Command="{Binding ToggleOperatorCommand}"
                    IsVisible="{Binding IsOperatorVisible}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="Ghost" Content="+ Condition" Command="{Binding AddConditionCommand}" />
          </Grid>

          <!-- Operator toggle (appears only when ≥ 2 conditions) -->
          <Border IsVisible="{Binding IsOperatorVisible}"
                  Background="{StaticResource SurfaceCard}"
                  CornerRadius="6"
                  Padding="10">
            <StackPanel Spacing="4">
              <TextBlock Text="Operator" Classes="CaptionUpper" />
              <ComboBox ItemsSource="{x:Static vm:RuleEditorViewModelStatics.AllOperators}"
                        SelectedItem="{Binding RuleOperator}"
                        HorizontalAlignment="Stretch" />
              <TextBlock Classes="BodySmall" TextWrapping="Wrap"
                         Text="All must be true = AND (every condition must hold). Any must be true = OR (rule fires if any one condition is true)." />
            </StackPanel>
          </Border>

          <!-- Empty-state hint -->
          <TextBlock Classes="BodySmall" Foreground="#FF8F8F"
                     IsVisible="{Binding Conditions.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                     Text="Add at least one condition to save the rule." />

          <ItemsControl ItemsSource="{Binding Conditions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConditionRowViewModel">
                <Border Background="{StaticResource SurfaceCard}" CornerRadius="6"
                        BorderBrush="{StaticResource SurfaceCardBorder}" BorderThickness="1"
                        Padding="10" Margin="0,4">
                  <StackPanel Spacing="6">

                    <!-- Row header: type picker + remove/move buttons -->
                    <Grid ColumnDefinitions="240,*,Auto,Auto,Auto">
                      <ComboBox ItemsSource="{Binding AllTriggerTypes}"
                                SelectedItem="{Binding TriggerType}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="BodySmall" Margin="8,0,0,0"
                                 Text="{Binding TriggerType}" />
                      <Button Grid.Column="2" Classes="Ghost" Content="↑"
                              Command="{Binding $parent[ItemsControl].DataContext.MoveConditionUpCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="3" Classes="Ghost" Content="↓"
                              Command="{Binding $parent[ItemsControl].DataContext.MoveConditionDownCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="4" Classes="Ghost" Content="Remove"
                              Command="{Binding $parent[ItemsControl].DataContext.RemoveConditionCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>

                    <!-- Edge triggers: no threshold -->
                    <TextBlock IsVisible="{Binding IsEdgeOnly}" Classes="BodySmall"
                               Text="Edge-style condition — evaluates the current state (no threshold)." />

                    <!-- Percent triggers: BatteryBelow / BatteryAbove -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsPercentTrigger}">
                      <TextBlock Text="{Binding ThresholdLabel}" />
                      <Grid ColumnDefinitions="160,Auto,*">
                        <NumericUpDown Value="{Binding TriggerPercent}" Minimum="0" Maximum="100" FormatString="0" />
                        <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </StackPanel>

                    <!-- Minutes trigger: TimeRemainingBelow -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsMinutesTrigger}">
                      <TextBlock Text="{Binding ThresholdLabel}" />
                      <Grid ColumnDefinitions="160,Auto,*">
                        <NumericUpDown Value="{Binding TriggerMinutes}" Minimum="1" Maximum="1440" FormatString="0" />
                        <TextBlock Grid.Column="1" Text="min" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </StackPanel>

                    <!-- Watts triggers -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsWattsTrigger}">
                      <TextBlock Text="{Binding ThresholdLabel}" />
                      <Grid ColumnDefinitions="160,Auto,*">
                        <NumericUpDown Value="{Binding TriggerWatts}" Minimum="0" Maximum="10000" FormatString="0" />
                        <TextBlock Grid.Column="1" Text="W" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </StackPanel>

                    <!-- Temperature triggers -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsTempTrigger}">
                      <TextBlock Text="{Binding ThresholdLabel}" />
                      <Grid ColumnDefinitions="160,Auto,*">
                        <NumericUpDown Value="{Binding TriggerTempC}" Minimum="-40" Maximum="120" Increment="0.5" FormatString="0.0" />
                        <TextBlock Grid.Column="1" Text="°C" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </StackPanel>

                    <!-- DeviceOffline: window instead of threshold -->
                    <StackPanel Spacing="4" IsVisible="{Binding IsOfflineTrigger}">
                      <TextBlock Text="{Binding ThresholdLabel}" />
                      <Grid ColumnDefinitions="160,Auto,*">
                        <NumericUpDown Value="{Binding TriggerOfflineSeconds}" Minimum="30" Maximum="86400" FormatString="0" />
                        <TextBlock Grid.Column="1" Text="sec" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Cooldown — always shown, applied to the composite's rising-edge fires -->
          <StackPanel Spacing="4" Margin="0,8,0,0">
            <TextBlock Text="Cooldown between fires" />
            <Grid ColumnDefinitions="160,Auto,*">
              <NumericUpDown Value="{Binding RuleCooldownSeconds}" Minimum="0" Maximum="86400" FormatString="0" />
              <TextBlock Grid.Column="1" Text="sec" VerticalAlignment="Center" Margin="8,0,0,0" />
              <TextBlock Grid.Column="2" Classes="BodySmall" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"
                         Text="Applied to the rule as a whole. After a fire, the next rising-edge is suppressed until this many seconds have elapsed." />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Actions -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="ACTIONS (run sequentially)" Classes="CaptionUpper" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="Ghost" Content="+ Action" Command="{Binding AddActionCommand}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Actions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ActionRowViewModel">
                <Border Background="{StaticResource SurfaceCard}" CornerRadius="6"
                        BorderBrush="{StaticResource SurfaceCardBorder}" BorderThickness="1"
                        Padding="10" Margin="0,4">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="200,*,Auto">
                      <ComboBox ItemsSource="{Binding AllTypes}"
                                SelectedItem="{Binding Type}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Classes="BodySmall"
                                 Text="{Binding Type}" />
                      <Button Grid.Column="2" Classes="Ghost" Content="Remove"
                              Command="{Binding $parent[ItemsControl].DataContext.RemoveActionCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>

                    <StackPanel Spacing="4" IsVisible="{Binding IsNotification}">
                      <TextBox Text="{Binding NotificationTitle}" Watermark="Notification title (supports {device}, {battery}, ...)" />
                      <TextBox Text="{Binding NotificationBody}" Watermark="Notification body" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="50" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsScript}">
                      <TextBox Text="{Binding ScriptPath}" Watermark="Script path (absolute)" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsLog}">
                      <TextBox Text="{Binding LogPath}" Watermark="Log path (optional; default: app log)" />
                      <TextBox Text="{Binding LogMessage}" Watermark="Log message template" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsWebhook}">
                      <TextBox Text="{Binding WebhookUrl}" Watermark="https://example.com/hook" />
                      <Grid ColumnDefinitions="100,*,Auto,120,Auto,120">
                        <ComboBox SelectedValue="{Binding WebhookMethod}">
                          <ComboBoxItem Content="POST" />
                          <ComboBoxItem Content="PUT" />
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="Retries:" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="3" Value="{Binding WebhookRetries}" Minimum="0" Maximum="5" />
                        <TextBlock Grid.Column="4" Text="Timeout ms:" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="5" Value="{Binding WebhookTimeoutMs}" Minimum="1000" Maximum="60000" />
                      </Grid>
                      <TextBox Text="{Binding WebhookHeaders}" Watermark="Headers: Authorization: Bearer ...&#x0A;(one per line)" AcceptsReturn="True" MinHeight="60" />
                      <TextBox Text="{Binding WebhookBodyTemplate}" Watermark="Optional body template (leave empty for default JSON)" AcceptsReturn="True" MinHeight="60" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsRunCommand}">
                      <TextBox Text="{Binding CommandWindows}" Watermark="Windows command (e.g. powershell -File C:\scripts\shut.ps1)" />
                      <TextBox Text="{Binding CommandMacOS}" Watermark="macOS command (e.g. /usr/local/bin/shut.sh)" />
                      <TextBox Text="{Binding CommandLinux}" Watermark="Linux command (e.g. /usr/local/bin/shut.sh)" />
                      <Grid ColumnDefinitions="120,*,Auto,120">
                        <ComboBox ItemsSource="{Binding AllShellKinds}"
                                  SelectedItem="{Binding Shell}" />
                        <TextBox Grid.Column="1" Text="{Binding WorkingDirectory}" Watermark="Working directory (optional)" />
                        <TextBlock Grid.Column="2" Text="Timeout ms:" VerticalAlignment="Center" />
                        <NumericUpDown Grid.Column="3" Value="{Binding CommandTimeoutMs}" Minimum="1000" Maximum="60000" />
                      </Grid>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Elevation warning -->
      <Border Background="#443322"
              CornerRadius="6"
              Padding="12"
              IsVisible="{Binding ElevationWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ElevationWarning}" TextWrapping="Wrap" Classes="BodySmall" />
      </Border>

      <!-- Buttons -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
        <Button Grid.Column="1" Classes="Ghost" Content="Cancel" Click="OnCancel" />
        <Button Grid.Column="2" Content="Save" IsEnabled="{Binding CanSave}" Click="OnSave" />
      </Grid>

    </StackPanel>
  </ScrollViewer>
</Window>
