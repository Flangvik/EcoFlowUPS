<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:EcoFlowMonitor.ViewModels.Automation"
        x:Class="EcoFlowMonitor.Views.Automation.RuleHistoryWindow"
        x:DataType="vm:RuleHistoryViewModel"
        Title="Rule History"
        Width="900" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundPrimary}">

  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <TextBlock Text="Rule Firing History" Classes="CaptionUpper" VerticalAlignment="Center" />
      <Button Grid.Column="1" Classes="Ghost" Content="Refresh" Command="{Binding RefreshCommand}" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" Classes="BodySmall" Margin="0,0,0,6"
               Text="{Binding Firings.Count, StringFormat='Showing {0} firings (newest first; up to 500 rows)'}" />

    <ListBox ItemsSource="{Binding Firings}" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:RuleFiringRowViewModel">
          <Expander Background="Transparent">
            <Expander.Header>
              <Grid ColumnDefinitions="180,200,140,*">
                <TextBlock Text="{Binding Timestamp}"   Classes="BodySmall" />
                <TextBlock Text="{Binding RuleName}"    FontWeight="SemiBold" />
                <TextBlock Text="{Binding Trigger}"     Classes="BodySmall" />
                <TextBlock Grid.Column="3" Text="{Binding Summary}" Classes="BodySmall" TextTrimming="CharacterEllipsis" />
              </Grid>
            </Expander.Header>
            <StackPanel Margin="20,4,4,8" Spacing="10">

              <!-- Per-condition truth grid (feature 002). Hidden on legacy rows. -->
              <StackPanel IsVisible="{Binding HasConditions}" Spacing="4">
                <TextBlock Text="{Binding OperatorLabel, StringFormat='Composite (operator: {0})'}"
                           Classes="CaptionUpper" />
                <ItemsControl ItemsSource="{Binding Conditions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConditionFiringRowVm">
                      <Grid ColumnDefinitions="32,160,*,32" Margin="0,2">
                        <TextBlock Text="{Binding Index}"       Classes="BodySmall" FontFamily="monospace" />
                        <TextBlock Text="{Binding Type}"        Grid.Column="1" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Params}"      Grid.Column="2" Classes="BodySmall" FontFamily="monospace" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ValueGlyph}"  Grid.Column="3" HorizontalAlignment="Center" FontWeight="Bold" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <TextBlock Text="{Binding Detail}"
                         FontFamily="monospace"
                         TextWrapping="Wrap"
                         Classes="BodySmall" />
            </StackPanel>
          </Expander>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
