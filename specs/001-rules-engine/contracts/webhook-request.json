{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EcoFlowMonitor Webhook Request Default Body",
  "description": "The JSON body sent by a Webhook action when the user has not specified a custom bodyTemplate. Fields are populated from the DeviceStateSnapshot captured at trigger-fire time. Null fields appear as JSON null (not 'unknown').",
  "type": "object",
  "required": [
    "event",
    "device",
    "timestamp"
  ],
  "properties": {
    "event": {
      "type": "object",
      "required": ["ruleId", "ruleName", "triggerType", "isTest"],
      "properties": {
        "ruleId":      { "type": "string", "description": "GUID" },
        "ruleName":    { "type": "string" },
        "triggerType": { "type": "string", "description": "Discriminator e.g. PowerLost, BatteryBelow, TempAbove" },
        "triggerValue": {
          "description": "Type-specific value (threshold, window size, ...). Null for edge triggers that carry no parameter.",
          "oneOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "isTest":      { "type": "boolean" }
      }
    },
    "device": {
      "type": "object",
      "required": ["serialNumber", "name", "powerStatus"],
      "properties": {
        "serialNumber": { "type": "string" },
        "name":         { "type": "string" },
        "batteryPct":   { "type": ["number", "null"] },
        "remainMin":    { "type": ["integer", "null"] },
        "tempC":        { "type": ["number", "null"] },
        "totalInW":     { "type": ["integer", "null"] },
        "totalOutW":    { "type": ["integer", "null"] },
        "acPluggedIn":  { "type": ["boolean", "null"] },
        "chargeState":  { "type": ["integer", "null"] },
        "powerStatus":  {
          "type": "string",
          "enum": ["Charging", "Idle", "PowerLost", "Unknown"]
        }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp (e.g. 2026-04-19T15:04:05Z) at which the trigger fired."
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "event": {
        "ruleId": "b2bf9a56-1c3d-4e11-9a2f-111111111111",
        "ruleName": "Notify HA on power loss",
        "triggerType": "PowerLost",
        "triggerValue": null,
        "isTest": false
      },
      "device": {
        "serialNumber": "DELTA3-MAX-000000000000",
        "name": "Living room UPS",
        "batteryPct": 82.0,
        "remainMin": 176,
        "tempC": 28.4,
        "totalInW": 0,
        "totalOutW": 145,
        "acPluggedIn": true,
        "chargeState": 0,
        "powerStatus": "PowerLost"
      },
      "timestamp": "2026-04-19T15:04:05Z"
    },
    {
      "event": {
        "ruleId": "b2bf9a56-1c3d-4e11-9a2f-222222222222",
        "ruleName": "Low battery alert",
        "triggerType": "BatteryBelow",
        "triggerValue": 15,
        "isTest": false
      },
      "device": {
        "serialNumber": "DELTA3-MAX-000000000000",
        "name": "Living room UPS",
        "batteryPct": 13.5,
        "remainMin": 12,
        "tempC": 31.1,
        "totalInW": 0,
        "totalOutW": 180,
        "acPluggedIn": false,
        "chargeState": 1,
        "powerStatus": "PowerLost"
      },
      "timestamp": "2026-04-19T15:21:07Z"
    }
  ]
}
