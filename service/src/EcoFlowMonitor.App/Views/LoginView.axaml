<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EcoFlowMonitor.ViewModels"
             x:Class="EcoFlowMonitor.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{StaticResource BackgroundPrimary}">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Classes="Card" Width="400" Padding="40">
            <StackPanel Spacing="8">
                <!-- Logo -->
                <Border Width="64" Height="64" CornerRadius="32"
                        Background="{StaticResource AccentPrimary}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⚡" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="White" />
                </Border>

                <!-- Title -->
                <TextBlock Text="EcoFlow Monitor" Classes="HeadingLarge"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Sign in with your EcoFlow account" Classes="BodySmall"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />

                <!-- Email -->
                <TextBlock Text="EMAIL" Classes="CaptionUpper" Margin="0,0,0,4" />
                <TextBox Text="{Binding Email}" Watermark="you@email.com" />

                <!-- Password -->
                <TextBlock Text="PASSWORD" Classes="CaptionUpper" Margin="0,16,0,4" />
                <TextBox Text="{Binding Password}" PasswordChar="&#x2022;"
                         RevealPassword="False" Watermark="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" />

                <!-- Sign In Button -->
                <Button Classes="Accent" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Margin="0,24,0,0" Height="44"
                        Command="{Binding SignInCommand}"
                        IsEnabled="{Binding !IsSigningIn}">
                    <Panel>
                        <TextBlock Text="Sign In" IsVisible="{Binding !IsSigningIn}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Signing in..." IsVisible="{Binding IsSigningIn}"
                                   HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
                    </Panel>
                </Button>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           Foreground="{StaticResource StatusPowerLost}"
                           TextWrapping="Wrap" FontSize="12"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />

                <!-- Divider -->
                <Border Height="1" Background="{StaticResource SurfaceCardBorder}" Margin="0,20,0,0" />
                <TextBlock Text="OR" Classes="CaptionUpper" HorizontalAlignment="Center" Margin="0,12" />

                <!-- BLE Only -->
                <Button Classes="Ghost" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Height="44"
                        Command="{Binding UseBleOnlyCommand}">
                    <TextBlock Text="Use Bluetooth Only (No Account)" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
