<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EcoFlowMonitor.ViewModels"
             xmlns:controls="using:EcoFlowMonitor.Controls"
             xmlns:converters="using:EcoFlowMonitor.Converters"
             xmlns:models="using:EcoFlowMonitor.Models"
             x:Class="EcoFlowMonitor.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="{StaticResource BackgroundPrimary}">

    <Grid ColumnDefinitions="240,*">
        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource BackgroundSecondary}"
                BorderBrush="{StaticResource SurfaceCardBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Bottom buttons -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="Ghost" Content="Refresh" Command="{Binding RefreshCommand}"
                                IsEnabled="{Binding !IsRefreshing}" Padding="8,6" FontSize="12" />
                        <Button Classes="Ghost" Content="Settings" Command="{Binding OpenSettingsCommand}"
                                Padding="8,6" FontSize="12" />
                    </StackPanel>
                    <Button Classes="Accent" Content="BLE Scan" Command="{Binding ScanBleCommand}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Padding="8,8" FontSize="12" />
                </StackPanel>

                <!-- Device list -->
                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="MY DEVICES" Classes="CaptionUpper" Margin="16,0,0,12" />

                    <ListBox ItemsSource="{Binding Devices}"
                             SelectedItem="{Binding SelectedDevice}"
                             Background="Transparent" BorderThickness="0"
                             Padding="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:DeviceViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,8" Height="36">
                                    <Ellipse Grid.Column="0" Width="8" Height="8"
                                             Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding IsConnected, Converter={x:Static converters:StatusColorConverter.Instance}}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                               Classes="BodyMedium" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ConnectionBadge}"
                                               Classes="BodySmall" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextMuted}" FontSize="9" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#1A00D4AA" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
                                <Setter Property="BorderThickness" Value="3,0,0,0" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{StaticResource SurfaceCardHover}" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- RIGHT CONTENT -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" Margin="24,16"
                        IsVisible="{Binding SelectedDevice, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel DataContext="{Binding SelectedDevice}" Spacing="16">

                    <!-- HERO: Battery + Status -->
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                        <controls:ArcBatteryGauge Grid.Column="0" Width="140" Height="140"
                                                   Percentage="{Binding BatteryPct}"
                                                   Status="{Binding PowerStatus}" />
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Classes="DisplayMedium">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}">
                                        <Binding Path="PowerStatus" Converter="{x:Static converters:StatusTextConverter.Instance}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                                <TextBlock.Foreground>
                                    <Binding Path="PowerStatus" Converter="{x:Static converters:StatusBrushConverter.Instance}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding IsConnected, Converter={x:Static converters:StatusColorConverter.Instance}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding IsConnected, Converter={x:Static converters:ConnectedTextConverter.Instance}}"
                                           Classes="BodySmall" />
                                <TextBlock Text="{Binding ActiveSource}" Classes="BodySmall"
                                           Foreground="{StaticResource AccentPrimary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding DisplayName}" Classes="BodySmall" />
                                <Button Classes="Ghost" Padding="6,2" FontSize="10"
                                        Content="{Binding ConnectionBadge}"
                                        Command="{Binding DataContext.CycleConnectionModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ToolTip.Tip="Click to cycle: Cloud → Auto → BLE" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusText}" Classes="BodySmall"
                                       Foreground="{StaticResource TextMuted}"
                                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Grid>

                    <!-- STATE BAR — CONN-01, CONN-02, UX-02 — D-01 full-width bar between hero and power flow -->
                    <Border Background="{StaticResource SurfaceCard}"
                            CornerRadius="6" Padding="12,8" Margin="0,4,0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <!-- Connection status dot — reuses existing GlowStatusIndicator -->
                                <controls:GlowStatusIndicator
                                    IsActive="{Binding IsConnected}"
                                    Width="8" Height="8" VerticalAlignment="Center" />
                                <!-- State text: "Connected", "Reconnecting...", "Error", etc. — CONN-01 -->
                                <TextBlock Text="{Binding ConnectionStateText}"
                                           Classes="BodySmall" VerticalAlignment="Center" />
                                <!-- Retry info: "attempt 3, next in 8s" — D-02 -->
                                <TextBlock Text="{Binding RetryInfoText}"
                                           Classes="BodySmall"
                                           Foreground="{StaticResource TextMuted}"
                                           IsVisible="{Binding RetryInfoText,
                                               Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <!-- Staleness badge: "Last update: 2m ago" — D-04, CONN-02 -->
                                <TextBlock Text="{Binding StalenessText}"
                                           Classes="BodySmall"
                                           Foreground="{StaticResource TextMuted}"
                                           IsVisible="{Binding IsStale}" />
                            </StackPanel>
                            <!-- Expandable error details button — D-08, visible only when HasError=true -->
                            <Button Grid.Column="1"
                                    Classes="Ghost"
                                    Content="Details"
                                    Padding="6,2"
                                    FontSize="10"
                                    IsVisible="{Binding HasError}"
                                    Command="{Binding DataContext.ShowErrorDetailCommand,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>
                    </Border>

                    <!-- POWER FLOW DIAGRAM -->
                    <controls:PowerFlowDiagram Height="180"
                                                InputW="{Binding TotalInW}"
                                                OutputW="{Binding TotalOutW}"
                                                SolarW="{Binding SolarW}"
                                                BatteryPct="{Binding BatteryPct}"
                                                Status="{Binding PowerStatus}" />

                    <!-- Stat cards — dims to 50% when stale (D-04) -->
                    <Grid Opacity="{Binding DataOpacity}">
                        <StackPanel Spacing="0">
                            <!-- STATS: Power -->
                            <UniformGrid Columns="5" Margin="0,8,0,0">
                                <controls:StatCard Label="INPUT" Value="{Binding TotalInW}" Unit="W"
                                                   ValueColor="{Binding TotalInW, Converter={x:Static converters:WattColorConverter.InstanceGreen}}" />
                                <controls:StatCard Label="SOLAR" Value="{Binding SolarW}" Unit="W"
                                                   ValueColor="{Binding SolarW, Converter={x:Static converters:WattColorConverter.InstanceGold}}" />
                                <controls:StatCard Label="OUTPUT" Value="{Binding TotalOutW}" Unit="W"
                                                   ValueColor="{Binding TotalOutW, Converter={x:Static converters:WattColorConverter.InstanceOrange}}" />
                                <controls:StatCard Label="DISCHARGE" StringValue="{Binding RemainingTime}" />
                                <controls:StatCard Label="CHARGE" StringValue="{Binding ChargeTime}" />
                            </UniformGrid>

                            <!-- STATS: Battery -->
                            <UniformGrid Columns="5">
                                <controls:StatCard Label="VOLTAGE" Value="{Binding VoltageV}" Unit="V" Format="F2" />
                                <controls:StatCard Label="CURRENT" Value="{Binding CurrentA}" Unit="A" Format="F2" />
                                <controls:StatCard Label="TEMP" Value="{Binding TempC}" Unit="&#xB0;C" Format="F1" />
                                <controls:StatCard Label="CYCLES" Value="{Binding Cycles}" />
                                <controls:StatCard Label="HEALTH" Value="{Binding SohPct}" Unit="%" />
                            </UniformGrid>

                            <!-- STATS: System -->
                            <UniformGrid Columns="5">
                                <controls:StatCard Label="AC FREQ" Value="{Binding AcFreqHz}" Unit="Hz" />
                                <controls:StatCard Label="USB OUT" Value="{Binding UsbOutW}" Unit="W" />
                                <controls:StatCard Label="MAX CHG" Value="{Binding MaxChgSoc}" Unit="%" />
                                <controls:StatCard Label="FAN" StringValue="{Binding FanLevel, Converter={x:Static converters:FanLevelConverter.Instance}}" />
                                <controls:StatCard Label="BATTS" StringValue="{Binding BattsConnected, StringFormat='{}{0}'}" />
                            </UniformGrid>

                            <!-- STATS: Capacity & Energy -->
                            <UniformGrid Columns="5">
                                <controls:StatCard Label="DESIGN" Value="{Binding DesignCapMah}" Unit="mAh" />
                                <controls:StatCard Label="REMAIN" Value="{Binding RemainCapMah}" Unit="mAh" />
                                <controls:StatCard Label="CELL &#x394;mV" Value="{Binding CellSpreadMv}" Unit="mV" />
                                <controls:StatCard Label="TOT CHG" Value="{Binding AccuChgWh}" Unit="Wh" />
                                <controls:StatCard Label="TOT DSG" Value="{Binding AccuDsgWh}" Unit="Wh" />
                            </UniformGrid>
                        </StackPanel>
                    </Grid>

                    <!-- CELL VOLTAGES PANEL -->
                    <Border Classes="Card" Padding="16" IsVisible="{Binding CellVoltages.Count}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="CELL VOLTAGES" Classes="CaptionUpper" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PackSn}" Classes="BodySmall" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding CellVoltages}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundSecondary}"
                                                CornerRadius="4" Padding="8,4" Margin="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding Index, StringFormat='#{0}'}"
                                                           FontSize="10" Foreground="{StaticResource TextMuted}"
                                                           VerticalAlignment="Center" Width="20" />
                                                <TextBlock Text="{Binding MilliVolts, StringFormat='{}{0} mV'}"
                                                           FontSize="12" FontFamily="JetBrains Mono, Consolas, monospace"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{x:Static converters:CellVoltageColorConverter.Instance}">
                                                            <Binding Path="IsMin" />
                                                            <Binding Path="IsMax" />
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- POWER CHART -->
                    <Border Classes="Card" Padding="16" Height="180">
                        <controls:PowerHistoryChart DataContext="{Binding}" />
                    </Border>

                    <!-- RULES SECTION -->
                    <StackPanel Spacing="8" Margin="0,8,0,24">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="RULES" Classes="CaptionUpper" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Classes="Ghost" Content="+ Add Rule"
                                    Command="{Binding DataContext.AddRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </Grid>

                        <!-- Empty state -->
                        <TextBlock Text="No rules configured. Add a rule to automate actions on power events."
                                   Classes="BodySmall" Margin="0,4,0,0"
                                   IsVisible="{Binding !Config.Rules.Count}" />

                        <!-- Rule list -->
                        <ItemsControl ItemsSource="{Binding Config.Rules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:RuleConfig">
                                    <Border Background="{StaticResource SurfaceCard}" CornerRadius="8"
                                            Padding="14,10" Margin="0,3"
                                            BorderBrush="{StaticResource SurfaceCardBorder}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Name}" Classes="BodyMedium" />
                                                <TextBlock Text="{Binding Trigger.Type}" Classes="BodySmall" />
                                            </StackPanel>
                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Enabled}"
                                                          OnContent="" OffContent="" Margin="0,0,8,0"
                                                          VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="Ghost" Content="Edit" Padding="8,4"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
